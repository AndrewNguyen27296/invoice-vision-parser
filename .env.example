# ---------------------------------------------------------------------------
# Pillar 2 - AI Invoice & Vision Parser
# Copy to ".env" and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# YOU MAY NOT NEED A KEY AT ALL.
#
# Digital PDFs are read from their own embedded text layer: free, instant, and
# more accurate than photographing the page. A vision model is only used for
# documents with NO text layer -- scans and phone photos. And `--mock` runs the
# entire pipeline with a canned response.
#
# So: no key is required to run the CLI, the test suite, or the Streamlit demo
# on the two digital sample invoices.
# ---------------------------------------------------------------------------

# --- Which vision backend handles scans -----------------------------------
#   anthropic  paid, best accuracy, US-hosted, content not used for training
#   gemini     FREE TIER available -- see the warning below
#   mock       canned response; no key, no network, no cost
PARSER_PROVIDER=mock

# Read the PDF text layer before spending anything. Turn this off only to
# measure the vision route (scripts/score_ground_truth.py --no-text-layer).
PARSER_USE_TEXT_LAYER=1

# --- Anthropic (paid) -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini (has a genuinely free tier) ----------------------------
# Free key: https://aistudio.google.com/apikey
#
# READ THIS BEFORE PUTTING A CLIENT'S INVOICE THROUGH THE FREE TIER:
# Google states that free-tier content IS used to improve their products;
# paid-tier content is not. That is fine for the fictional samples in this
# repo. It is NOT fine for a prospect's real supplier invoice -- that is a
# GDPR conversation you do not want to have in a live demo. Use a paid tier
# or a provider whose terms you can show the client.
GEMINI_API_KEY=
PARSER_GEMINI_MODEL=gemini-flash-latest
PARSER_GEMINI_FREE_TIER=1        # 0 = paid key: start pricing calls, drop the badge

# --- Model selection -------------------------------------------------------
# claude-haiku-4-5 is the cheapest vision-capable model ($1/MTok in, $5/MTok out)
# and is the correct default for high-volume invoice work.
# Escalate to claude-sonnet-5 only for a specific client whose documents are
# genuinely hard (handwriting, dense multi-page tables).
PARSER_MODEL=claude-haiku-4-5
PARSER_MAX_OUTPUT_TOKENS=1600

# --- COST GUARDRAILS (the anti-bill-shock layer) ---------------------------
# Longest image edge sent to the model. Vision cost is (w*h)/750 tokens, so
# this single number is the biggest lever you have on per-page spend.
#   1120 px -> ~1.5k image tokens -> ~$0.005 / page   (recommended for demos)
#   1568 px -> ~3.0k image tokens -> ~$0.008 / page   (max useful resolution)
PARSER_MAX_IMAGE_EDGE=1120

# Hard stops. Any of these tripping raises BudgetExceeded BEFORE the API call.
PARSER_MAX_PAGES_PER_DOC=3          # a 400-page PDF cannot drain your account
PARSER_MAX_UPLOAD_MB=15             # reject oversized uploads at the door
PARSER_DAILY_USD_BUDGET=2.00        # rolling per-day spend ceiling
PARSER_DAILY_PAGE_LIMIT=300         # rolling per-day page ceiling
PARSER_SESSION_PAGE_LIMIT=25        # per demo visitor / per process

# Identical file uploaded twice = zero API cost. Set 0 to disable.
# The key includes model, resolution, output budget and prompt version, so
# changing any of those correctly misses the cache instead of serving a stale
# answer that looks fresh.
PARSER_CACHE_ENABLED=1

# Where the cache and the usage ledger live. Defaults to <project>/.cache --
# anchored to the project, NOT the working directory, so the daily budget cannot
# be reset just by running the CLI from somewhere else.
# PARSER_CACHE_DIR=

# --- API call bounds ------------------------------------------------------
# The SDK defaults (600s timeout, 2 retries) are wrong for a live demo: a
# stalled call parks the page for ten minutes, and retries can bill 3x for one
# extraction. Keep the timeout comfortably above your slowest real page.
PARSER_API_TIMEOUT_S=40
PARSER_API_MAX_RETRIES=1

# Price a model that is not in the built-in table (a new release, or a paid
# Gemini tier). USD per million tokens. Leave unset to use the table.
# PARSER_PRICE_IN=0.30
# PARSER_PRICE_OUT=2.50
